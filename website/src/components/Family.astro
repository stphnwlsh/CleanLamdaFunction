---
// The five Lean Mean Clean Apps templates, each with its own ring logo and colour.
import { Image } from 'astro:assets';
import minimalapi from '../assets/logos/minimalapi.svg';
import minimalapiLight from '../assets/logos/minimalapi-light.svg';
import webapi from '../assets/logos/webapi.svg';
import webapiLight from '../assets/logos/webapi-light.svg';
import graphql from '../assets/logos/graphql.svg';
import graphqlLight from '../assets/logos/graphql-light.svg';
import mcp from '../assets/logos/mcp.svg';
import mcpLight from '../assets/logos/mcp-light.svg';
import lambda from '../assets/logos/lambda.svg';
import lambdaLight from '../assets/logos/lambda-light.svg';

const templates = [
  { name: 'Clean Minimal API', note: 'Minimal APIs', hue: 'minimalapi', dark: minimalapi, light: minimalapiLight, href: 'https://github.com/stphnwlsh/CleanMinimalApi' },
  { name: 'Clean Web API', note: 'Controllers', hue: 'webapi', dark: webapi, light: webapiLight, href: 'https://github.com/stphnwlsh/CleanWebApi' },
  { name: 'Clean GraphQL API', note: 'Hot Chocolate', hue: 'graphql', dark: graphql, light: graphqlLight, href: 'https://github.com/stphnwlsh/CleanGraphQLApi' },
  { name: 'Clean Model Context Protocol', note: 'MCP server', hue: 'mcp', dark: mcp, light: mcpLight, href: 'https://github.com/stphnwlsh/CleanModelContextProtocol' },
  { name: 'Clean Lambda Function', note: 'AWS Lambda', hue: 'lambda', dark: lambda, light: lambdaLight, href: import.meta.env.BASE_URL, current: true },
];
---

<div class="cl-family not-content">
  {
    templates.map((t) => (
      <a href={t.href} aria-current={t.current ? 'page' : undefined} style={`--cl-family-hue: var(--lmca-${t.hue})`}>
        <Image src={t.dark} alt="" width={64} height={64} class="light:sl-hidden" />
        <Image src={t.light} alt="" width={64} height={64} class="dark:sl-hidden" />
        <span>
          {t.name}
          <small>{t.note}</small>
        </span>
      </a>
    ))
  }
</div>
