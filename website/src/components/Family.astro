---
const templates = [
  { name: 'Clean Minimal API', note: 'ASP.NET Core Minimal APIs', href: 'https://github.com/stphnwlsh/CleanMinimalApi' },
  { name: 'Clean Web API', note: 'ASP.NET Core controllers', href: 'https://github.com/stphnwlsh/CleanWebApi' },
  { name: 'Clean GraphQL API', note: 'Hot Chocolate', href: 'https://github.com/stphnwlsh/CleanGraphQLApi' },
  { name: 'Clean Model Context Protocol', note: 'MCP server', href: 'https://github.com/stphnwlsh/CleanModelContextProtocol' },
  { name: 'Clean Lambda Function', note: 'AWS Lambda', href: import.meta.env.BASE_URL, current: true },
];
---

<div class="cl-family not-content">
  {
    templates.map((t) => (
      <a href={t.href} aria-current={t.current ? 'page' : undefined}>
        <span>
          {t.name}
          <small>{t.note}</small>
        </span>
      </a>
    ))
  }
</div>
