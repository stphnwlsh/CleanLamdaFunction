---
import Default from '@astrojs/starlight/components/Footer.astro';
import { Image } from 'astro:assets';
import org from '../assets/logos/org-spectrum-small-tile.svg';

const community = 'https://github.com/LeanMeanCleanApps/.github/blob/main';
---

<Default><slot /></Default>
<div class="cl-footer">
  <a class="cl-org" href="https://leanmeancleanapps.github.io/">
    <Image src={org} alt="" width={28} height={28} />
    <span>Part of <b>Lean Mean Clean Apps</b></span>
  </a>
  <nav aria-label="Lean Mean Clean Apps">
    <a href={`${community}/SUPPORT.md`}>Support</a>
    <a href={`${community}/SECURITY.md`}>Security</a>
    <a href={`${community}/CONTRIBUTING.md`}>Contributing</a>
    <a href="https://leanmeancleanapps.github.io/brand/">Brand</a>
    <a href="https://github.com/sponsors/stphnwlsh">Sponsor</a>
  </nav>
  <p>
    Made by <a href="https://github.com/stphnwlsh">Stephen Walsh</a> with Clean Architecture, strong coffee and a healthy
    disregard for pomp and ceremony. Not affiliated with AWS, Uncle Bob or anyone with a marketing budget.
  </p>
</div>

<style>
  .cl-footer {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-align: center;
  }

  .cl-footer a {
    color: inherit;
  }

  .cl-org {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }

  .cl-org b {
    font-family: var(--lmca-font-display);
    color: var(--sl-color-white);
  }

  .cl-footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
  }

  .cl-footer p {
    margin: 0;
    max-width: 40rem;
  }
</style>
